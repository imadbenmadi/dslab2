   "frameId": null,
   "seed": 1615892811,
   "version": 1,
   "versionNonce": 638019486,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Coverage is enforced in the car app: on radio_net every car could reach every zone,\nso a car only talks to the zone covering its simulated position (none in a tunnel).",
   "originalText": "Coverage is enforced in the car app: on radio_net every car could reach every zone,\nso a car only talks to the zone covering its simulated position (none in a tunnel).",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null
  },
  {
   "id": "te77",
   "type": "text",
   "x": 1640,
   "y": 870,
   "width": 552.0999999999999,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 1083438815,
   "version": 1,
   "versionNonce": 1492026738,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Different --cpus limits make the fogs different sizes.\nMeasured YOLO times per model size set how long each task runs.",
   "originalText": "Different --cpus limits make the fogs different sizes.\nMeasured YOLO times per model size set how long each task runs.",
