   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The runner controls every container through the Docker API:\nstarts and stops them, sets netem per scenario, injects failures.",
   "originalText": "The runner controls every container through the Docker API:\nstarts and stops them, sets netem per scenario, injects failures.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null
  },
  {
   "id": "te76",
   "type": "text",
   "x": 700,
   "y": 990,
   "width": 726.0999999999999,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#0c8599",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
