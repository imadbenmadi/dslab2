   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1  Highway car: about 3 s per zone -> frequent handoffs; steps are placed\n    in the next zone ahead (C3)",
   "originalText": "1  Highway car: about 3 s per zone -> frequent handoffs; steps are placed\n    in the next zone ahead (C3)",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null
  },
  {
   "id": "te238",
   "type": "text",
   "x": 1300,
   "y": 2985,
   "width": 664.62,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 179796361,
   "version": 1,
   "versionNonce": 571630913,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2  Tunnel = coverage gap: the anchor holds the result until the car\n    reconnects or the deadline passes (C12)",
   "originalText": "2  Tunnel = coverage gap: the anchor holds the result until the car\n    reconnects or the deadline passes (C12)",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null
  },
  {
   "id": "te239",
   "type": "text",
   "x": 1300,
   "y": 3080,
   "width": 782.9399999999999,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 1549226796,
   "version": 1,
   "versionNonce": 450612830,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "3  Roundabout: 3 possible exits -> the predictor keeps up to 3 candidate zones;\n    no proactive move without a safety margin; wrong guess -> C7",
   "originalText": "3  Roundabout: 3 possible exits -> the predictor keeps up to 3 candidate zones;\n    no proactive move without a safety margin; wrong guess -> C7",
