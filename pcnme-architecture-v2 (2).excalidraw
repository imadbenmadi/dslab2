  {
   "id": "te264",
   "type": "text",
   "x": 1300,
   "y": 3940,
   "width": 1019.5799999999999,
   "height": 106.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 1338632473,
   "version": 1,
   "versionNonce": 368741222,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Blue = placed on the anchor zone's fog (zone 1).  Green = placed on zone 2 (less loaded GPU).\nRed arrows = critical path: S1 -> S2 -> S4 -> result. Latency = this path, including transfers.\nS2 and S3 run in parallel. A step starts only when all its inputs have arrived.\nEach step is a separate decision of the anchor's agent; the state includes where the input data is.\nIf the end-to-end hard deadline passes, the remaining steps are cancelled and the task is dropped (C9).",
   "originalText": "Blue = placed on the anchor zone's fog (zone 1).  Green = placed on zone 2 (less loaded GPU).\nRed arrows = critical path: S1 -> S2 -> S4 -> result. Latency = this path, including transfers.\nS2 and S3 run in parallel. A step starts only when all its inputs have arrived.\nEach step is a separate decision of the anchor's agent; the state includes where the input data is.\nIf the end-to-end hard deadline passes, the remaining steps are cancelled and the task is dropped (C9).",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "roundness": null
  },
